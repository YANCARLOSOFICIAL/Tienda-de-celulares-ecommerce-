# ------------------------------------------------------------------
# Overrides opcionales para docker-compose.yml (raiz del repo).
# Copia a .env solo si necesitas cambiar puertos o credenciales de la DB.
# El stack funciona sin este archivo: estos son los valores por defecto.
# ------------------------------------------------------------------

# Puerto del host para la API (contenedor escucha en 8000)
API_PORT=8001

# Puerto del host para PostgreSQL (contenedor escucha en 5432)
DB_PORT=5434

# Credenciales de PostgreSQL
POSTGRES_USER=tiendacell
POSTGRES_PASSWORD=tiendacell
POSTGRES_DB=tiendacell
