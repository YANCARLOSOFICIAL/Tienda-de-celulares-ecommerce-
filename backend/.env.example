# ============================================================
# Tienda Cell - Backend
# Copia este archivo a .env y ajusta los valores.
# NUNCA uses los valores de ejemplo en producción.
# ============================================================

# PostgreSQL (SQLAlchemy URL)
# Puerto 5433 para evitar conflicto con un PostgreSQL local en 5432
DATABASE_URL=postgresql+psycopg://tiendacell:tiendacell@localhost:5433/tiendacell

# Seguridad JWT
# Genera una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please-generate-a-secure-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (formato JSON, separados por comas dentro del array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Credenciales del seed (solo desarrollo)
SEED_ADMIN_EMAIL=admin@tiendacell.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_EMAIL=usuario@tiendacell.com
SEED_USER_PASSWORD=Usuario123!

# Factus - Facturación electrónica DIAN
# Usa el sandbox para pruebas: https://api-sandbox.factus.com.co
# Producción: https://api.factus.com.co
# Las credenciales las entrega Factus al contratar el servicio.
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
# Versión de la API de tu cuenta ('v1' o 'v2'). La v2 usa códigos DIAN y precios sin IVA.
FACTUS_API_VERSION=v2
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
# Opcional: si tienes más de un rango de numeración activo, indica su ID
FACTUS_NUMBERING_RANGE_ID=
# Porcentaje de IVA por defecto para los productos
FACTUS_DEFAULT_TAX_RATE=19.00
